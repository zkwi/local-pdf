{
  "name": "local-pdf",
  "version": "0.7.0",
  "private": true,
  "description": "Local PDF — convert PDF to Word, Markdown and images, and Word, Markdown and images to PDF, entirely in your browser. Private, free, open source.",
  "keywords": [
    "pdf",
    "docx",
    "word",
    "markdown",
    "ocr",
    "browser",
    "offline",
    "privacy",
    "pdf-to-word",
    "paddleocr"
  ],
  "homepage": "https://localpdfconverter.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkwi/local-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/zkwi/local-pdf/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "assets": "node scripts/copy-runtime-assets.mjs",
    "ocr-models": "node scripts/download-ocr-models.mjs",
    "ocr-runtime": "node scripts/copy-ort-runtime.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build && node scripts/prerender-tools.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-runtime-assets.mjs"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
